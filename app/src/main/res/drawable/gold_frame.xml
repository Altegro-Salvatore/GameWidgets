<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка с двойной золотой окантовкой (как портрет персонажа) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gw_card" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/gw_gold" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#66C59B4B" />
        </shape>
    </item>
</layer-list>
