<?xml version="1.0" encoding="utf-8"?>
<!-- Элемент списка квестов: строка пергамента с чекбоксом -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quest_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/gold_frame"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/quest_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/gw_text"
        android:textSize="14sp"
        android:fontFamily="serif"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Кнопка выполнения (квадратик) -->
    <TextView
        android:id="@+id/btn_done"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/check_box"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/gw_gold"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
